# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키 (모험 힌트 로드뷰에만 사용)
# (JavaScript 키는 공개용 키. 카카오 콘솔의 Web 플랫폼 도메인 등록으로 사용처를 제한함)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 백엔드 .env의 GOOGLE_CLIENT_IDS와 같은 값. 콘솔에 승인된 리디렉션 URI로 <프론트 주소>/login/callback 등록 필요
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 마중 백엔드 API 주소 (배포 서버)
NEXT_PUBLIC_API_BASE_URL=https://durumungsil.parafara.com

# 배포 서버가 죽었을 때(연결 실패, 502/503/504, Cloudflare 52x) 대신 붙을 2차 백엔드 주소
NEXT_PUBLIC_API_FALLBACK_BASE_URL=http://localhost:8080

# 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보 > API 키
# Maps JavaScript API + Places API (New)만 허용하고, HTTP 리퍼러로 사용처를 제한함
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 구글 클라우드 콘솔 > Google Maps Platform > 지도 관리(Map Management)에서 발급한 JavaScript 지도 ID
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Search Console > 속성 추가(URL 접두어: https://majung-seven.vercel.app/) > 소유권 확인 > HTML 태그
# <meta name="google-site-verification" content="여기 값"> 의 content만 넣음
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
