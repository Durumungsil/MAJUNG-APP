# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키
# (JavaScript 키는 공개용 키. 카카오 콘솔의 Web 플랫폼 도메인 등록으로 사용처를 제한함)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 백엔드 .env의 GOOGLE_CLIENT_IDS와 같은 값. 콘솔에 승인된 리디렉션 URI로 <프론트 주소>/login/callback 등록 필요
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 마중 백엔드 API 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

NEXT_PUBLIC_GOOGLE_MAPS_KEY=